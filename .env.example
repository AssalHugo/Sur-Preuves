# ==============================================================================
# Configuration d'environnement - Comparateur Science 2027 (csc)
# ==============================================================================

# Base de données PostgreSQL avec extension pgvector
POSTGRES_USER=csc
POSTGRES_PASSWORD=csc
POSTGRES_DB=csc
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://csc:csc@127.0.0.1:5432/csc
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_WORK_MEM=16MB

# Fournisseur LLM (Gemini uniquement - google-genai)
GEMINI_API_KEY=
GEMINI_FREE_API_KEY=
LLM_MONTHLY_CAP_USD=9

# Connecteurs externes (L04, L07)
OPENALEX_API_KEY=
NOSPARLEMENTAIRES_API_KEY=

# Sauvegardes locales (L16 / make backup)
BACKUP_DIR=./var/backups

# Back-office de relecture (L14)
REVIEW_PORT=8000
REVIEW_AUTH=local
